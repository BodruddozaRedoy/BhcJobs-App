# Copy to `.env` and adjust to target a different environment.
#
# Only `EXPO_PUBLIC_*` variables are visible to the app — Expo inlines them into the
# JS bundle at build time, so anyone with the APK can read them. Never put a secret
# here. Restart the dev server after editing; the values are inlined, not read at
# runtime.
#
# Every variable below has a fallback in `constants/config.ts` pointing at the dev
# backend, so the app runs without this file at all.

# Backend API root.
EXPO_PUBLIC_API_BASE_URL=https://dev.bhcjobs.com

# Public file storage root. Industry and company images are resolved against this
# as `{STORAGE_URL}/{entity}-image/{filename}` — see `lib/media.ts`.
EXPO_PUBLIC_STORAGE_URL=https://dev.bhcjobs.com/storage

# SAR -> BDT rate behind the approximate salary figures on job cards. No endpoint
# exposes a rate, so it is pinned here and every derived figure is labelled
# "approx." Override to correct it without a code change.
EXPO_PUBLIC_SAR_TO_BDT=33
